{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run db:generate:auth && pnpm run cf:types && pnpm run typecheck && nuxt build",
    "dev": "nuxt dev",
    "dev:systemd": "systemd-run --user --scope -p MemoryMax=4096M nuxt dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "clean": "rm -rf .output .wrangler .nuxt node_modules",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate:auth": "dotenv -e .env -- pnpx @better-auth/cli generate --config auth.config.ts --output server/db/auth.ts -y && eslint --fix server/db/auth.ts",
    "db:generate": "pnpm run db:generate:auth && dotenv -e .env drizzle-kit generate",
    "cf:deploy": "pnpm run build && wrangler --cwd .output deploy",
    "cf:types": "wrangler types shared/wrangler.d.ts && eslint --fix shared/wrangler.d.ts",
    "cf:dev": "wrangler dev",
    "cf:migrate": "wrangler d1 migrations apply flower"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.972.0",
    "@aws-sdk/lib-storage": "^3.972.0",
    "@aws-sdk/s3-request-presigner": "^3.972.0",
    "@langchain/cloudflare": "^1.0.1",
    "@langchain/core": "^1.1.16",
    "@nuxt/eslint": "1.12.1",
    "@nuxt/ui": "^4.4.0",
    "@trpc/client": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "@vueuse/core": "^14.1.0",
    "@vueuse/nuxt": "^14.1.0",
    "better-auth": "^1.4.17",
    "drizzle-orm": "^0.45.1",
    "nuxt": "^4.2.2",
    "trpc-nuxt": "^2.0.1",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.86",
    "@types/node": "^25.0.10",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "miniflare": "^4.20260116.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.2",
    "wrangler": "^4.59.3"
  }
}
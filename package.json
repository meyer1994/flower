{
  "name": "flower",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:systemd": "systemd-run --user --scope -p MemoryMax=4096M nuxt dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "clean": "rm -rf .output .wrangler .nuxt node_modules",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "auth:generate": "pnpm dotenv -e .env -- pnpm better-auth generate --config auth.config.ts --output server/db/auth.ts -y && pnpm eslint --fix server/db/auth.ts",
    "db:generate": "dotenv -e .env drizzle-kit generate",
    "db:migrate": "pnpm run cf:migrate",
    "cf:deploy": "wrangler --cwd .output deploy",
    "cf:types": "wrangler types shared/wrangler.d.ts && eslint --fix shared/wrangler.d.ts",
    "cf:migrate": "wrangler d1 migrations apply flower",
    "cf:secrets": "wrangler secret bulk .env"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/lib-storage": "^3.975.0",
    "@aws-sdk/s3-request-presigner": "^3.975.0",
    "@better-auth/stripe": "^1.4.17",
    "@iconify-json/simple-icons": "^1.2.68",
    "@langchain/cloudflare": "^1.0.1",
    "@langchain/core": "^1.1.17",
    "@nuxt/eslint": "1.13.0",
    "@nuxt/ui": "^4.4.0",
    "@trpc/client": "^11.9.0",
    "@trpc/server": "^11.9.0",
    "@vueuse/components": "^14.1.0",
    "@vueuse/core": "^14.1.0",
    "@vueuse/nuxt": "^14.1.0",
    "better-auth": "^1.4.17",
    "drizzle-orm": "^0.45.1",
    "mailgun.js": "^12.7.0",
    "nuxt": "^4.3.0",
    "stripe": "^20.2.0",
    "trpc-nuxt": "^2.0.1",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.17",
    "@iconify-json/lucide": "^1.2.87",
    "@types/mailgun-js": "^0.22.19",
    "@types/node": "^25.0.10",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "mcp-remote": "^0.1.37",
    "nitro-cloudflare-dev": "^0.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.4",
    "wrangler": "^4.61.0"
  }
}
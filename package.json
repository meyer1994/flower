{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "clean": "rm -rf .output .wrangler .nuxt node_modules",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "auth:generate": "dotenv -e .env -- pnpx auth@latest generate --config auth.config.ts --output server/db/auth.ts -y && eslint --fix server/db/auth.ts",
    "db:generate": "pnpm run auth:generate && dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply flower",
    "test": "vitest run --reporter verbose",
    "cf:deploy": "pnpm run build && wrangler --cwd .output deploy",
    "cf:types": "wrangler types shared/wrangler.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@aws-sdk/s3-request-presigner": "^3.1050.0",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/ui": "^4.7.1",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "better-auth": "^1.6.11",
    "better-call": "^2.0.3",
    "db0": "^0.3.4",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.4.6",
    "tailwindcss": "^4.3.0",
    "trpc-nuxt": "^2.0.2",
    "uuidv7": "^1.2.1",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@nuxt/test-utils": "^4.0.3",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.9.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.3.1",
    "wrangler": "^4.93.0"
  }
}
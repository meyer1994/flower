{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "clean": "rm -rf .output .wrangler .nuxt node_modules",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "auth:generate": "auth generate --config auth.config.ts --output server/db/auth.ts -y && eslint --fix server/db/auth.ts",
    "db:generate": "pnpm run auth:generate && drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply edtr",
    "cf:deploy": "wrangler --cwd .output deploy",
    "cf:types": "wrangler types shared/wrangler.d.ts && eslint --fix shared/wrangler.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/lib-storage": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@iconify-json/lucide": "^1.2.134",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/ui": "^4.11.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/vue-3": "3.31.3",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "uuidv7": "^1.2.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "auth": "^1.7.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.11.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.135.0"
  }
}
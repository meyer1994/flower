From the user input, and using the guide below, you will implement tRPC client
calls in Vue components.

# Hands on guide

Below is a hands on guide on the patterns used in this project to use tRPC
client methods in Vue components.

```vue
<script setup lang="ts">
// trpc client is available in the app via useNuxtApp()
const { $trpc } = useNuxtApp();

// ALWAYS use useAsyncData for data fetching to benefit from Nuxt's SSR,
// caching, and state management
// returns: data, status, error, refresh
const { data, status, error, refresh } = await useAsyncData(
  "unique-key", // unique key for caching and deduplication
  async () => await $trpc.items.list.query(),
);

// you can use dynamic keys to fetch data based on reactive values (e.g. route
// params). this will trigger a re-fetch when the value changes
const route = useRoute();
const { data: item } = await useAsyncData(
  () => `item-${route.params.id}`, // dynamic key triggers re-fetch on change
  async () => await $trpc.items.get.query({ id: route.params.id }),
);

// use Promise.all to fetch multiple queries in parallel. this makes the pages
// load way faster and makes use of trpc batching
const [
  { data: items, refresh: refreshItems },
  { data: files, refresh: refreshFiles },
] = await Promise.all([
  useAsyncData("items", async () => await $trpc.items.list.query()),
  useAsyncData("files", async () => await $trpc.files.list.query()),
]);
</script>
```

## Mutations

For mutations (create, update, delete), use direct `$trpc.*.mutate()` calls
inside handler functions. This keeps the code simple and avoids unnecessary
complexity.

```vue
<script setup lang="ts">
const { $trpc } = useNuxtApp();

// fetch data with useAsyncData (as shown above)
const { data: items, refresh: refreshItems } = await useAsyncData(
  "items",
  async () => await $trpc.items.list.query(),
);

// prefer using async functions over const functions, because they can be
// referenced above in the code, while const functions must be already defined
async function onCreateItem(data: { name: string }) {
  // call mutate directly - simple and straightforward
  await $trpc.items.create.mutate(data);
  // refresh related queries after success
  await refreshItems();
}

async function onUpdateItem(id: string, data: { name: string }) {
  await $trpc.items.update.mutate({ id, ...data });
  await refreshItems();
}

async function onDeleteItem(id: string) {
  await $trpc.items.delete.mutate({ id });
  await refreshItems();
}
</script>

<template>
  <!-- use loading state from the form component itself (see ui-form.mdc) -->
  <FormItem @submit="async (e) => await onCreateItem(e.data)" />

  <div v-for="item in items" :key="item.id">
    {{ item.name }}
    <UButton @click="onDeleteItem(item.id)">Delete</UButton>
  </div>
</template>
```

## When to use each method

| Method           | Use Case                   | Features                           |
| :--------------- | :------------------------- | :--------------------------------- |
| `useAsyncData`   | Data fetching (queries)    | SSR, Caching, Reactive (via watch) |
| `$trpc.*.mutate` | Mutations in handlers      | Simple, direct, no overhead        |
| `$trpc.*.query`  | One-off, non-reactive call | Simple scripts, utilities          |

## Complete example

A full page example combining queries and mutations.

```vue
<script setup lang="ts">
import type { FormItemData } from "~~/components/FormItem.vue";

const { $trpc } = useNuxtApp();

// queries: fetch data with useAsyncData
const { data: items, refresh: refreshItems } = await useAsyncData(
  "items",
  async () => await $trpc.items.list.query(),
);

// mutations: simple async functions that call mutate directly
async function onSubmit(data: FormItemData) {
  await $trpc.items.create.mutate(data);
  await refreshItems();
}

async function onDelete(id: string) {
  await $trpc.items.delete.mutate({ id });
  await refreshItems();
}
</script>

<template>
  <div>
    <!-- form handles its own loading state via @submit event -->
    <FormItem @submit="async (e) => await onSubmit(e.data)" />

    <div v-for="item in items" :key="item.id">
      {{ item.name }}
      <UButton @click="onDelete(item.id)">Delete</UButton>
    </div>
  </div>
</template>
```
